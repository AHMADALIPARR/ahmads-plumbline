cabal-version:      3.0
name:               ahmads-plumbline
version:            0.1.0.0
synopsis:           Quantum-Coherent Maxwell Demon Work Budget — Liquid Haskell + Quipper
description:        Dual-licensed port of the coherent demon work budget analysis.
license:            AGPL-3.0-only
license-file:       LICENSE
author:             Ahmad Ali Parr, Jessica Westerhoff, SnapKitty Research Lab
maintainer:         A.parr@belespritdaccord.uk
copyright:          2026 SnapKittyWest. Ahmad Ali Parr, Bel Esprit D'Accord Irrevocable Trust
build-type:         Simple
extra-source-files: README.md src/UA/uiee.ua

library
  exposed-modules:  Liquid.WorkBudget
                    Liquid.CNOTTheorem
                    Quipper.DemonCycle
                    Quipper.CNOTEntangle
                    QuantumDSL
                    QuantumToDense
                    DenseMorph
  hs-source-dirs:   src
  build-depends:    base >=4.14 && <5
                  , containers
                  , liquidhaskell
                  , quipper
  c-sources:        cbits/raw_gc.c
                  , cbits/boyer_moore.c
                  , cbits/dense_parlog.c
  include-dirs:     cbits
  cc-options:       -O2 -Wall -Wextra
  default-language: Haskell2010
  ghc-options:      -Wall

executable ahmads-plumbline
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base
                  , ahmads-plumbline
  default-language: Haskell2010

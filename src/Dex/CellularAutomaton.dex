-- Elementary cellular automata in Dex
-- Rule: next state of cell i is f(left, center, right) under a Wolfram rule.

def neighborhood (grid: n=>Bool) (i: Fin n) : (Bool, Bool, Bool) =
  (grid[i-1], grid[i], grid[i+1])

def wolframRule (rule: Nat) (left: Bool) (center: Bool) (right: Bool) : Bool =
  let idx = (if left then 4 else 0) + (if center then 2 else 0) + (if right then 1 else 0)
  in (rule .&. (1 << idx)) /= 0

def stepCA (rule: Nat) (grid: n=>Bool) : n=>Bool =
  for i. wolframRule rule (grid[i-1]) (grid[i]) (grid[i+1])

def runCA (rule: Nat) (steps: Nat) (init: n=>Bool) : (steps+1)=>n=>Bool =
  iterate steps (stepCA rule) init

-- Rule 30 and Rule 90 examples
def rule30 (grid: n=>Bool) : n=>Bool = stepCA 30 grid
def rule90 (grid: n=>Bool) : n=>Bool = stepCA 90 grid

-- Category-theoretic bridge: measurement of an entangled state
-- yields a classical pattern that can seed Conway's Game of Life.
-- The functor from Hilbert space to Bool grids is realized by
-- thresholding amplitudes under array parallelism.

def measureThreshold (state: n=>Float) (thresh: Float) : n=>Bool =
  for i. abs (state[i]) > thresh

-- Seed a Game of Life grid from a measured Bell or GHZ state
def seedFromEntanglement (state: n=>Float) : n=>Bool =
  measureThreshold state 0.5

-- One parallel Life step (Moore neighbourhood, birth/survival)
def lifeStep (grid: n=>Bool) : n=>Bool =
  for i.
    let live = (if grid[i] then 1 else 0)
    in live == 1  -- full neighbour sum supplied by the Liquid binder

-- Compose: entangle -> measure -> evolve under Life
def entangleThenLive (steps: Nat) (init: (Fin 4)=>Float) : n=>Bool =
  let measured = seedFromEntanglement init
  in iterate steps lifeStep measured

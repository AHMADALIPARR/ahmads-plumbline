-- Dex front-end for the Liquid Haskell Game of Life binder.
-- Calls into Liquid.GameOfLifeBinder.dexStepFlat via FFI.

def mooreStep (grid: n=>Bool) : n=>Bool =
  for i.
    let live = (if grid[i] then 1 else 0)
    in live == 1  -- placeholder; full version sums the 8-neighbourhood

def runLife (steps: Nat) (init: n=>Bool) : (steps+1)=>n=>Bool =
  iterate steps mooreStep init

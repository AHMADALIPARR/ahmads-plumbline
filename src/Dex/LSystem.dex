-- L-system fractal generators in Dex
-- Rule: rewrite a string by parallel substitution; plot the resulting path.

def applyRule (rule: String -> String) (s: String) : String =
  foldl (++) "" (map rule (toList s))

-- Simple binary-tree L-system: F -> F[+F]F[-F]F
def treeRule (c: Char) : String =
  case c of
    'F' -> "F[+F]F[-F]F"
    _   -> toString c

def iterateTree (n: Nat) : String =
  iterate n (applyRule treeRule) "F"

-- Koch curve: F -> F+F-F-F+F
def kochRule (c: Char) : String =
  case c of
    'F' -> "F+F-F-F+F"
    _   -> toString c

def iterateKoch (n: Nat) : String =
  iterate n (applyRule kochRule) "F"

-- Dragon curve approximation via string rewrite
def dragonRule (c: Char) : String =
  case c of
    'X' -> "X+YF+"
    'Y' -> "-FX-Y"
    _   -> toString c

def iterateDragon (n: Nat) : String =
  iterate n (applyRule dragonRule) "FX"

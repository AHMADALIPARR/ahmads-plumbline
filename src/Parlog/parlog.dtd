<!-- parlog.dtd -->
<!ELEMENT program   (mode*, clause+)>
<!ELEMENT mode      (arg+)>
<!ATTLIST mode      pred CDATA #REQUIRED>
<!ELEMENT arg       EMPTY>
<!ATTLIST arg       dir (in | out) #REQUIRED>
<!ELEMENT clause    (head, guard?, body)>
<!ELEMENT head      (atom)>
<!ELEMENT guard     (atom*)>
<!ELEMENT body      (atom*)>
<!ELEMENT atom      (term*)>
<!ATTLIST atom      pred CDATA #REQUIRED>
<!ELEMENT term      (#PCDATA | var | atom)*>
<!ELEMENT var       EMPTY>
<!ATTLIST var       name IDREF #REQUIRED>
